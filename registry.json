      "dependencies": [],
      "registryDependencies": [],
      "cssVars": {
        "light": {
          "paper": "oklch(100% 0 0)",
          "paper-2": "oklch(96.5% 0 0)",
          "ink": "oklch(15% 0 0)",
          "ink-2": "oklch(45% 0 0)",
          "rule": "oklch(83% 0 0)",
          "accent": "oklch(15% 0 0)",
          "accent-ink": "oklch(100% 0 0)",
          "focus": "oklch(15% 0 0)",
