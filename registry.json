          "warning": "oklch(65% 0.18 75)",
          "error": "oklch(55% 0.22 25)",
          "info": "oklch(55% 0.18 240)"
        },
        "dark": {
          "paper": "oklch(12% 0 0)",
          "paper-2": "oklch(18% 0 0)",
          "ink": "oklch(95% 0 0)",
          "ink-2": "oklch(68% 0 0)",
          "rule": "oklch(30% 0 0)",
          "accent": "oklch(95% 0 0)",
          "accent-ink": "oklch(12% 0 0)",
          "focus": "oklch(95% 0 0)",
