          "text-lg": "1.05rem",
          "text-xl": "1.3rem",
          "text-display": "2.25rem",
          "space-3xs": "0.25rem",
          "space-2xs": "0.5rem",
          "space-xs": "0.75rem",
          "space-sm": "1rem",
          "space-md": "1.5rem",
          "space-lg": "2.5rem",
          "space-xl": "3.5rem",
          "space-2xl": "5rem",
          "space-3xl": "6rem"
        }
      },
